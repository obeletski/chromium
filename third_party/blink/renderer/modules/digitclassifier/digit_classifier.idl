// Entry point for the bundled MNIST digit classifier, reached as
// `navigator.digitclassifier`. The model runs on the GPU out of process, so
// acquiring it is asynchronous.
[
  Exposed=Window,
  RuntimeEnabled=DigitClassifier,
  SecureContext
] interface DigitClassifier {
  [CallWith=ScriptState, RaisesException]
  Promise<DigitClassifierModel> getModel();
};
